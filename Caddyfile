# Esperanza / O'Neill static replica — served by Caddy on Railway.
# Railway injects $PORT; Caddy listens there. Static root is /srv/public,
# assembled by build.mjs from the June-8 scrape with URLs re-pointed at our CF infra.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv/public
	encode zstd gzip

	# Same-origin proxy to the public API so the browser avoids CORS (the API only
	# allows the esperanzahomes.com origin). The live island fetches /api/public/*.
	handle /api/* {
		reverse_proxy https://esperanza-api.round-base-ed8c.workers.dev {
			header_up Host esperanza-api.round-base-ed8c.workers.dev
		}
	}

	# Frozen snapshot fires XHRs to /xhr/* (recommend, oicheck, form posts). Answer
	# same-origin with benign JSON so they resolve quietly (recommend section renders
	# empty; forms are deferred until HubSpot) instead of erroring on the dead domain.
	handle /xhr/* {
		header Content-Type application/json
		respond `{"data":{"content":""},"success":true}` 200
	}

	# Pretty URLs: /new-homes/available/ -> /new-homes/available/index.html
	try_files {path} {path}/index.html {path}.html

	file_server

	# Long cache for the immutable theme; short for HTML.
	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /
	header @html Cache-Control "public, max-age=300"

	# Unmigrated paths (blog archives, JS-only floorplans catalog, the media/PDF
	# library) fall through to the still-live O'Neill site so nav stays clickable.
	handle_errors {
		@notfound expression {err.status_code} == 404
		redir @notfound https://www.esperanzahomes.com{uri} 302
	}
}
